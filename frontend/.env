# 카카오모빌리티 Directions API용 REST API 키 (서버사이드 전용, NEXT_PUBLIC_ 아님)
# Vercel 프로젝트 설정 > Environment Variables 에 등록하세요
# 실제 값은 이 파일(.env)이 아니라 .env.local에 넣으세요 — .env.local은 .gitignore로 제외됩니다.
KAKAO_REST_API_KEY=

# 카카오 디벨로퍼스 > JavaScript 키 (REST 키 아님, 지도 표시용)
# 카카오 콘솔 "플랫폼 > Web"에 localhost:3000 과 Vercel 배포 도메인을 등록해야 지도가 뜸
NEXT_PUBLIC_KAKAO_JS_KEY=
